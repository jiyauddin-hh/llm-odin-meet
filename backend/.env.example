DATABASE_URL="postgresql://quantum:quantum@localhost:5917/quantumcode"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=7319
RUNNER_IMAGE="quantumcode-runner"
MAX_PARALLEL_JOBS=4

# Password-reset emails. Leave SMTP_HOST empty to print reset links to the server log instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Public address of the site, used in reset links (defaults to the address the request came from).
APP_URL=

# Live classroom video call. STUN works on one network; add a TURN server for
# students on other networks (e.g. coturn: TURN_URL=turn:turn.example.com:3478).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Serve over HTTPS (required for camera/mic from any machine other than localhost).
# Run tools/https-cert.sh to create a self-signed pair, then point these at it.
HTTPS_KEY=
HTTPS_CERT=

# Daily AI class (backend/src/lib/aiTeacher). The Claude Code CLI is found automatically
# (PATH, ~/.local/bin, or the VS Code extension); set CLAUDE_BIN to use another one.
CLAUDE_BIN=
AI_TEACHER_MODEL=sonnet
# Face photo or short front-facing video (default tools/avatar/faces/teacher.jpg).
AI_TEACHER_FACE=
OLLAMA_URL=http://127.0.0.1:11434
